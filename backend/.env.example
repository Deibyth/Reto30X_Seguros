# LLM Provider — Groq (cloud, gratis)
# Más modelos: https://console.groq.com/docs/models
# Obtén tu API key gratis: https://console.groq.com/keys
LLM_API_KEY=gsk_tu-api-key-aqui
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Database
DATABASE_URL=sqlite+aiosqlite:///data/proteccion360.db

# App
ENVIRONMENT=development
DEBUG=true
